DATABASE_URL=postgresql://mailflow:mailflow@127.0.0.1:55432/mailflow
# Shared with the host app (at least 32 characters). Signs events, checks and admin sign-in links.
MAILFLOW_SECRET=
# mailflow POSTs checks to <HOST_URL>/checks, e.g. https://app.example.com/webhooks/mailflow
HOST_URL=http://127.0.0.1:58100
# Optional: the "Back to app" link in the admin header.
HOST_ADMIN_URL=
LISTMONK_URL=http://127.0.0.1:59000
LISTMONK_API_USER=mailflow
LISTMONK_API_TOKEN=
MAIL_FROM="Your Company <mail@example.com>"
# Optional: bearer token for the AI skills (at least 32 characters).
MAILFLOW_API_TOKEN=
# on | off. Turn off on extra replicas if you want a single sender; the lease makes several safe.
WORKER=on
WORKER_INTERVAL_MS=30000
