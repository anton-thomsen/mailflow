{
  "name": "mailflow",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "e2e": "tsx scripts/e2e.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "mjml": "^5.4.1",
    "next": "15.5.24",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@tailwindcss/postcss": "4.3.1",
    "@types/mjml": "^5.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.0.3"
  }
}
